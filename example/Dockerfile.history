# Build stage
FROM node:20-alpine AS builder

# Set build argument for routing mode
ARG VITE_ROUTING_MODE=history

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source files
COPY . .

# Build the application for history mode
RUN npm run build:history

# Production stage
FROM nginx:alpine

# Copy built files to nginx
COPY --from=builder /app/dist-history /usr/share/nginx/html

# Copy nginx configuration for SPA routing with history mode
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
